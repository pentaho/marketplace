<overlay id="admin.perspective.overlay.ee">

  <treechildren id="adminCatTreeChildren">

    <treeitem id="marketplaceOsgi" container="true"
              command="mantleXulHandler.loadAdminContent('marketplaceOsgi', 'osgi/@pentaho/marketplace@${project.version}/main.html')">
      <treerow>
        <treecell label="${title}" />
      </treerow>
    </treeitem>

  </treechildren>
</overlay>
